{
	"name": "de.plexdev.lovapp",
	"version": "1.0.0",
	"description": "UI5 Application: de.plexdev.lovapp",
	"author": "PlexDev",
	"license": "Apache-2.0",
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "ui5 build --clean-dest",
		"build:opt": "ui5 build self-contained --clean-dest --all",
		"build:prod": "ui5 build --config=ui5.yaml --clean-dest --all --dest dist --include-task=generateVersionInfo",
		"start": "ui5 serve --port 8080 -o index.html --accept-remote-connections",
		"start:https": "ui5 serve --port 8080 -o index.html --accept-remote-connections --h2",
		"start-cdn": "ui5 serve --port 8080 -o index-cdn.html",
		"start:dist": "npm start -- --config ui5-dist.yaml",
		"start:dist-cdn": "npm run start-cdn -- --config ui5-dist.yaml",
		"start:http": "http-server ./dist",
		"lint": "eslint webapp",
		"karma": "karma start",
		"karma-ci": "karma start karma-ci.conf.js",
		"karma-ci-cov": "karma start karma-ci-cov.conf.js",
		"test": "npm run lint && npm run karma-ci-cov",
		"wdi5": "wdio run ./webapp/test/e2e/\\wdio.conf.js",
		"cordova:prepare": "npm run build:prod && node scripts/copy-www.js && cordova prepare",
		"cordova:build:android": "npm run cordova:prepare && cordova build android",
		"cordova:build:ios": "npm run cordova:prepare && cordova build ios",
		"cordova:run:android": "npm run cordova:prepare && cordova run android",
		"cordova:run:ios": "npm run cordova:prepare && cordova run ios",
		"cordova:emulate:android": "npm run cordova:prepare && cordova emulate android",
		"cordova:emulate:ios": "npm run cordova:prepare && cordova emulate ios"
	},
	"devDependencies": {
		"@ui5/cli": "^3.11.0",
		"@ui5/middleware-code-coverage": "^1.1.1",
		"@wdio/cli": "^7.16.4",
		"@wdio/local-runner": "^7.16.4",
		"@wdio/mocha-framework": "^8.39.0",
		"@wdio/spec-reporter": "^8.39.0",
		"cordova": "^12.0.0",
		"cordova-android": "^12.0.1",
		"cordova-ios": "^7.0.1",
		"eslint": "^8.57.0",
		"fs-extra": "^11.2.0",
		"karma": "^6.4.3",
		"karma-chrome-launcher": "^3.2.0",
		"karma-coverage": "^2.2.1",
		"karma-ui5": "^3.0.4",
		"prettier": "^3.3.3",
		"rimraf": "^5.0.7",
		"ui5-middleware-livereload": "^3.0.3",
		"wdio-ui5-service": "^1.5.6",
		"cordova-plugin-whitelist": "^1.3.5",
		"cordova-plugin-vibration": "^3.1.1",
		"cordova-plugin-device-motion": "^2.0.1",
		"cordova-plugin-media": "^5.0.4",
		"cordova-plugin-device": "^2.1.0",
		"cordova-plugin-network-information": "^3.0.0",
		"cordova-plugin-statusbar": "^4.0.0",
		"cordova-plugin-splashscreen": "^6.0.2"
	},
	"dependencies": {
		"ui5-middleware-route-proxy": "^1.0.10"
	},
	"cordova": {
		"plugins": {
			"cordova-plugin-whitelist": {},
			"cordova-plugin-vibration": {},
			"cordova-plugin-device-motion": {},
			"cordova-plugin-media": {},
			"cordova-plugin-device": {},
			"cordova-plugin-network-information": {},
			"cordova-plugin-statusbar": {},
			"cordova-plugin-splashscreen": {}
		}
	}
}
